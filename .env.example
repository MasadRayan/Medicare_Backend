NODE_ENV=development
PORT=8000
DATABASE_URL="Your database connection string here"
JWT_ACCESS_SECRET="Your JWT access secret here"
JWT_REFRESH_SECRET="Your JWT refresh secret here"
JWT_ACCESS_EXPIRES_IN="Your JWT access token expiration time here (e.g., 15m, 1h, 1d)"
JWT_REFRESH_EXPIRES_IN="Your JWT refresh token expiration time here (e.g., 15m, 1h, 1d)"
BCRYPT_SALT_ROUNDS="Your bcrypt salt rounds here (e.g., 10, 12, 14)"
BACKEND_URL="Your backend URL here (e.g., http://localhost:8000)"
FRONTEND_URL="Your frontend URL here (e.g., http://localhost:3000)"
GOOGLE_CLIENT_ID="Your Google OAuth client ID here"

# Seed accounts (created on server boot if not exist)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="Super@admin12345"
TESTER_ADMIN_NAME="Tester Admin"
TESTER_ADMIN_EMAIL="testeradmin@example.com"
TESTER_ADMIN_PASSWORD="Tester@admin12345"
TESTER_DOCTOR_NAME="Tester Doctor"
TESTER_DOCTOR_EMAIL="testerdoctor@example.com"
TESTER_DOCTOR_PASSWORD="Tester@doctor12345"

# Redis (REDIS_USERNAME or REDIS_USER both accepted)
REDIS_USERNAME="default"
REDIS_PASSWORD="your-redis-password"
REDIS_HOST="your-redis-host.db.redis.io"
REDIS_PORT="14125"

# Email (Nodemailer / Gmail App Password)
SMTP_USER="youremail@gmail.com"
EMAIL_SENDER="youremail@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# bKash (Sandbox)
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_USERNAME="sandboxTokenizedUser02"
BKASH_PASSWORD="sandboxTokenizedUser02@12345"
BKASH_APP_KEY="your-bkash-app-key"
BKASH_APP_SECRET="your-bkash-app-secret"
BKASH_CALLBACK_URL="http://localhost:8000/api/payment/callback"
